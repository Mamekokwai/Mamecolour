{
  "name": "mamecolour",
  "displayName": "Mamecolour Theme Palette",
  "description": "Derive a complete VS Code workbench palette from one base window color.",
  "version": "0.1.2",
  "publisher": "Nywerya",
  "license": "MIT",
  "icon": "public/icon/Icon_V1.0.png",
  "galleryBanner": {
    "color": "#1A1722",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mamekokwai/Mamecolour"
  },
  "homepage": "https://github.com/Mamekokwai/Mamecolour#readme",
  "bugs": {
    "url": "https://github.com/Mamekokwai/Mamecolour/issues",
    "email": "Nywerya@gmail.com"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color",
    "palette",
    "workbench"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:mamecolour.setBaseColor",
    "onCommand:mamecolour.applyBaseColor",
    "onCommand:mamecolour.resetColors"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mamecolour.setBaseColor",
        "title": "Mamecolour: Set Window Base Color"
      },
      {
        "command": "mamecolour.applyBaseColor",
        "title": "Mamecolour: Apply Base Color"
      },
      {
        "command": "mamecolour.resetColors",
        "title": "Mamecolour: Reset Generated Colors"
      }
    ],
    "configuration": {
      "title": "Mamecolour",
      "properties": {
        "mamecolour.baseColor": {
          "type": "string",
          "default": "#1A1722",
          "description": "Base window color in #RRGGBB format.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mamecolour.themeName": {
          "type": "string",
          "default": "",
          "description": "Optional theme scope inside workbench.colorCustomizations. Leave empty to apply to all themes."
        },
        "mamecolour.configurationTarget": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "enumDescriptions": [
            "Write colors to this workspace's .vscode/settings.json.",
            "Write colors to the user settings.json."
          ],
          "default": "workspace",
          "description": "Where generated color customizations are saved."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx --yes @vscode/vsce package",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:verify": "npm run check && npm run package"
  }
}
